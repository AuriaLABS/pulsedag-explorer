# Use "live" to call PulseDAG or "mock" for the deterministic local fixture.
VITE_DATA_MODE=live

# Browser-facing read-only gateway. The Vite dev server proxies /rpc to PULSEDAG_RPC_TARGET.
VITE_API_BASE_URL=/rpc
VITE_POLL_INTERVAL_MS=15000

# v3/mainnet identity guard. Keep the identity values empty until PulseDAG Task31/#1049 freezes them.
# Production mainnet deployments must pin all three values before being advertised as mainnet.
VITE_EXPECTED_RELEASE_MAJOR=
VITE_EXPECTED_NETWORK_PROFILE=
VITE_EXPECTED_CHAIN_ID=
VITE_REQUIRE_CONTRACTS_DISABLED=true

# Server-side development proxy target. Keep the node RPC bound to loopback.
PULSEDAG_RPC_TARGET=http://127.0.0.1:8080
